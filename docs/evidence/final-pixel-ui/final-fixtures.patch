+    fun testIdenticalDrivingFramesKeepRecordedTripAndIncomeWithInsuranceAndFuelInstalled() {
+        val zone = Observation.Available(ZoneId.of("UTC"))
+        val frames = listOf(observation(), observation(100_000), observation(100_001, 0.0, Gear.PARK),
+            observation(103_001, 0.0, Gear.PARK)).map { DrivingFrame(it, zone) }
+
+        fun record(dbName: String, installed: Set<Facility>): ObservedDrivingReceipt {
+            val games = GameSessionFactory(context, mapOf(source to dbName), source)
+            ok(games.open()).use { game ->
+                // 설치 상태만 다른 격리 fixture다. 시설 구입·차감은 별도 장치 시험에서 다룬다.
+                ok(game.store.atomic { db ->
+                    for (facility in installed) db.execSQL("INSERT INTO facilities VALUES (?)", arrayOf(facility.name))
+                    ContractResult.Success(Unit)
+                })
+                assertEquals(installed, ok(game.store.rental.shop()).facilities)
+                ok(game.store.activateObservedDriving(game.identity.profileId))
+            }
+            val reducer = ObservedDrivingReducer(RecordingPolicy(200_000, 200_000, 1_000, 3_000, 0.1, 0.5)) {
+                "same-driving-frames"
+            }
+            val input = SessionObservedDrivingSource(games, journal, reducer) {
+                ok(AssetTrialDefinitionProvider(context.assets).load()).drivingIncomeRules()
+            }
+            val receipt = frames.flatMap { frame ->
+                val observation = frame.observation
+                ok(input.observe("same-receiver", frame, RecordingClock(observation.receivedElapsedMs, observation.receivedAt))).committed
+            }.single()
+            assertEquals(1_000L, receipt.commit.recordedMeters)
+            assertEquals(1_000L, receipt.commit.rewardedMeters)
+            assertEquals(rules.incomePerKm, receipt.commit.amount)
+            assertEquals(MoneyChange(MoneyDirection.CREDIT, rules.incomePerKm), receipt.commit.settlement?.transaction?.money)
+            return receipt
+        }
+
+        val bareDb = "$name-bare"
+        val installedDb = "$name-installed"
+        try {
+            val bare = record(bareDb, emptySet())
+            val installed = record(installedDb, setOf(Facility.INSURANCE, Facility.FUEL_STATION))
+            assertEquals(bare.trip, installed.trip)
+            assertEquals(bare.commit.copy(settlement = null), installed.commit.copy(settlement = null))
+        } finally {
+            listOf(bareDb, installedDb).forEach(context::deleteDatabase)
+        }
+    }
